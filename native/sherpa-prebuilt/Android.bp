// libsherpa-ncnn-jni —— STT 引擎（sherpa-ncnn + ncnn + openfst 三件套静态合体）
// ABI 面对齐 Gradle abiFilters：仅 arm64-v8a。
// 决策（2026-09-22）：sherpa 线走 prebuilt，不做源码 Soong 化。
// .so 由 CI android-build 的 commit_native_prebuilts 开关抽取回写
// （tools/intree/extract_native_prebuilts.sh）。
// 注意：本 .so 含静态链接的 ncnn（Tencent，BSD-3）与 openfst（Apache-2.0），再分发合规。
cc_prebuilt_library_shared {
    name: "libsherpa-ncnn-jni",
    visibility: ["//packages/apps/Operit:__subpackages__"],
    compile_multilib: "64",

    arch: {
        arm64: {
            srcs: ["lib/arm64-v8a/libsherpa-ncnn-jni.so"],
        },
    },
}
