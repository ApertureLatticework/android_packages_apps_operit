// liboperit_ffmpeg 暂存定义——文件名刻意避开 Android.bp：
// libav* 与 libffmpeg_cli 依赖在 external/ffmpeg fork（vendor 翻转 + avfilter/avdevice
// 补齐 + fftools 模块，清单见 ../local_manifests/upstream-ports.xml 注释）落地前不存在，
// 现在就叫 Android.bp 会让 Soong 依赖解析失败、拖垮全树 m。
// fork 就绪后本文件改名 Android.bp 即接线。
cc_library_shared {
    name: "liboperit_ffmpeg",
    visibility: ["//packages/apps/Operit:__subpackages__"],
    srcs: ["operit_ffmpeg_jni.cpp"],
    cflags: [
        "-std=c++17",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "libavcodec",
        "libavformat",
        "libavutil",
        "libswresample",
        "libswscale",
        "libavfilter",
        "libavdevice",
        // fork 侧 fftools CLI 库（-Dmain=ffmpeg_cli_main 改名入口）
        "libffmpeg_cli",
    ],
}
