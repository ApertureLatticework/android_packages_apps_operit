// Operit 主模块树内定义（2026-09-22 正式翻牌，commit b37498b）。
// 翻牌前置条件已全部在这棵 LOS 23.2 树上验明：
//   - external/ffmpeg fork（ApertureLatticework/android_external_ffmpeg，
//     定制 4 后 libavfilter/libavdevice/libffmpeg_cli 全部编通）
//   - 136 个包内 prebuilt（android_library_import/java_import）+ native 五件
//   - 树内 androidx（25 件直引）与 Kotlin 系模块（下划线命名）逐一实名核验
// 注意：本 bp 生效即要求树内有 external/ffmpeg（local_manifests/upstream-ports.xml）；
//       只装 aperture.xml 不装 upstream-ports.xml 的树会解析失败，两份清单成对安装。
//
android_library {
    name: "operit-lib",
    visibility: ["//packages/apps/Operit:__subpackages__"],
    platform_apis: true,
    min_sdk_version: "26",

    // 副屏原生化（步骤 7）删除 Shower 线后，quickjs 模块 Kotlin 源并入本库；
    // showerclient 的 AIDL 由原生后端替代，不再参与树内构建
    srcs: [
        "app/src/main/java/**/*.kt",
        "app/src/main/java/**/*.java",
        "app/src/main/room-generated/**/*.java",
        "app/src/main/aidl/**/*.aidl",
        "quickjs/src/main/java/**/*.kt",
        // 树内版 BuildConfig（Gradle 生成物不进树；见 libs/DEPS.md）
        "app/src/soong/java/**/*.java",
        "app/src/soong/java/**/*.kt",
    ],
    resource_dirs: ["app/src/main/res"],
    // aapt2 依赖 manifest package 生成 R 类（com.ai.assistance.operit.R）
    manifest: "app/src/main/AndroidManifest.xml",

    static_libs: [
        // ---- 树内 androidx / Kotlin（零 vendoring，直接引模块名） ----
        "kotlin-stdlib",
        "kotlin-reflect",
        "kotlinx_coroutines_android",  // 树内命名（external/kotlinx.coroutines）
        "operit-kotlinx-serialization-json",  // 树内 1.8.1 漂移（1.9.0 包内 prebuilt）
        "operit-kotlinx-coroutines-guava",  // ListenableFuture.await()；树内无 guava 变体
        "androidx.core_core-ktx",
        "androidx.activity_activity-compose",
        "androidx.activity_activity-ktx",
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-text",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material3_material3-window-size-class",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.animation_animation",
        "androidx.compose.animation_animation-core",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.navigation_navigation-compose",
        "androidx.room_room-runtime",
        "androidx.room_room-ktx",
        "androidx.datastore_datastore-preferences",
        "androidx.datastore_datastore-preferences-core",
        "androidx.work_work-runtime-ktx",
        "androidx.window_window",
        "androidx.webkit_webkit",
        "androidx.documentfile_documentfile",
        "androidx.compose.ui_ui-tooling-preview",
        "kotlin-parcelize-runtime",
        "androidx.glance_glance-appwidget",
        "androidx.glance_glance-material3",
        "operit-security-crypto",
        // media3 与 security-crypto 树内（android-16.0.0_r4 prebuilts）实核缺失，
        // 走包内 prebuilt（2026-09-22 审计：29 个 androidx 引用仅此 4 件不在树，其余树内直引）
        "operit-media3-common",
        "operit-media3-exoplayer",
        "operit-media3-ui",

        // ---- 包内 prebuilt 全量平铺（lock 全集；与 Gradle 传递闭包类路径等价，
        //      依赖边交由全量集合消解，不依赖 import 模块间声明） ----
        "operit-accompanist-drawablepainter",
        "operit-accompanist-systemuicontroller",
        "operit-android-gif",
        "operit-androidsvg",
        "operit-apk-parser",
        "operit-apksig",
        "operit-auto-value",
        "operit-auto-value-annotations",
        "operit-axml",
        "operit-backdrop",
        "operit-bcpkix-jdk15to18",
        "operit-bcprov",
        "operit-bcprov-jdk15to18",
        "operit-bcutil-jdk15to18",
        "operit-checker-compat-qual",
        "operit-checker-qual",
        "operit-coil",
        "operit-coil-base",
        "operit-coil-compose",
        "operit-coil-compose-base",
        "operit-coil-gif",
        "operit-colorpicker",
        "operit-common",
        "operit-commons-codec",
        "operit-commons-collections4",
        "operit-commons-compress",
        "operit-commons-io",
        "operit-commons-lang3",
        "operit-commons-math3",
        "operit-curvesapi",
        "operit-error-prone-annotations",
        "operit-failureaccess",
        "operit-firebase-annotations",
        "operit-firebase-components",
        "operit-firebase-encoders",
        "operit-firebase-encoders-json",
        "operit-firebase-encoders-proto",
        "operit-flogger",
        "operit-flogger-system-backend",
        "operit-gson",
        "operit-guava",
        "operit-hjson",
        "operit-hnswlib-core",
        "operit-hnswlib-utils",
        "operit-image",
        "operit-image-cropper",
        "operit-itextg",
        "operit-j2objc-annotations",
        "operit-java-diff-utils",
        "operit-javax-inject",
        "operit-jieba",
        "operit-jlatexmath",
        "operit-jlatexmath-android-font-cyrillic",
        "operit-jlatexmath-android-font-greek",
        "operit-jsoup",
        "operit-jsr305",
        "operit-junrar",
        "operit-kotlin-logging",
        "operit-kotlin-sdk-core",
        "operit-kotlinx-collections-immutable",
        "operit-kotlinx-io-bytestring",
        "operit-kotlinx-io-core",
        "operit-ktor-client-core",
        "operit-ktor-client-okhttp",
        "operit-ktor-events",
        "operit-ktor-http",
        "operit-ktor-http-cio",
        "operit-ktor-io",
        "operit-ktor-serialization",
        "operit-ktor-server-core",
        "operit-ktor-server-websockets",
        "operit-ktor-sse",
        "operit-ktor-utils",
        "operit-ktor-websocket-serialization",
        "operit-ktor-websockets",
        "operit-liquid",
        "operit-listenablefuture",
        "operit-log4j-api",
        "operit-mcp-sdk-client",
        "operit-media3-common",
        "operit-media3-container",
        "operit-media3-database",
        "operit-media3-datasource",
        "operit-media3-decoder",
        "operit-media3-exoplayer",
        "operit-media3-extractor",
        "operit-media3-ui",
        "operit-mediapipe-tasks-text",
        "operit-mlkit-text-recognition",
        "operit-mlkit-text-recognition-chinese",
        "operit-mlkit-text-recognition-devanagari",
        "operit-mlkit-text-recognition-japanese",
        "operit-mlkit-text-recognition-korean",
        "operit-nanohttpd",
        "operit-okhttp",
        "operit-okhttp-logging-interceptor",
        "operit-okhttp-sse",
        "operit-okio",
        "operit-onnxruntime",
        "operit-pdfbox-android",
        "operit-play-services-base",
        "operit-play-services-basement",
        "operit-play-services-mlkit-text-recognition",
        "operit-play-services-mlkit-text-recognition-chinese",
        "operit-play-services-mlkit-text-recognition-common",
        "operit-play-services-mlkit-text-recognition-devanagari",
        "operit-play-services-mlkit-text-recognition-japanese",
        "operit-play-services-mlkit-text-recognition-korean",
        "operit-play-services-tasks",
        "operit-poi",
        "operit-poi-ooxml",
        "operit-poi-ooxml-lite",
        "operit-poi-scratchpad",
        "operit-protobuf-javalite",
        "operit-relinker",
        "operit-renderx",
        "operit-reorderable",
        "operit-security-crypto",
        "operit-shapes",
        "operit-slf4j-api",
        "operit-sparsebitset",
        "operit-swipe",
        "operit-tasks-core",
        "operit-tensorflow-lite",
        "operit-text-recognition-bundled-common",
        "operit-tink-android",
        "operit-transport-api",
        "operit-transport-backend-cct",
        "operit-transport-runtime",
        "operit-uuid",
        "operit-vision-common",
        "operit-vision-interfaces",
        "operit-xmlbeans",
        "operit-zip4j",
        "operit-zipalign-java",
        "operit-zxing-core",
    ],

    kotlincflags: [
        "-jvm-target 17",
        "-Xjvm-default=all",
        "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true",
        // kotlinx.serialization 编译器插件（external/kotlinc/lib 自带；@Serializable 的
        // serializer() 生成 intrinsic 依赖它——缺则 MarketStatsApiService 式批量报错）
        "-Xplugin=external/kotlinc/lib/kotlinx-serialization-compiler-plugin.jar",
        // @Parcelize（SerializableColorScheme 等数据模型）；runtime 为树内模块（下行 static_libs）
        "-Xplugin=external/kotlinc/lib/parcelize-compiler.jar",
    ],
}

android_app {
    name: "Operit",
    defaults: ["platform_app_defaults"],
    privileged: true,
    certificate: "platform",
    platform_apis: true,
    min_sdk_version: "26",

    manifest: "app/src/main/AndroidManifest.xml",
    static_libs: ["operit-lib"],
    asset_dirs: ["app/src/main/assets"],

    // native 库经 required 随包安装到 priv-app lib 目录；
    // ffmpeg 走源码线薄壳（native/operit-ffmpeg/Android.bp.tree，链树内 libav* + libffmpeg_cli）。
    // onnxruntime/tflite 的 .so 在 prebuilt AAR 内随 import 自动打包，不经 required
    required: [
        "libquickjsjni",
        "libstreamnative",
        "libtoolpkgwasm",
        "libsherpa-ncnn-jni",
        "liboperit_ffmpeg",
        "liboperit_ripgrep",
    ],

    // 体积对齐 Gradle 版（R8 全量压缩 + 资源收缩）
    optimize: {
        enabled: true,
        shrink: true,
        proguard_flags_files: ["app/proguard-rules.pro"],
    },
}
