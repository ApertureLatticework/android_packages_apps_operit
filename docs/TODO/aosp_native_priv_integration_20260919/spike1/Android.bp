// LOS 23.2 Compose spike（结论版，对齐 development/samples/SceneTransitionLayoutDemo 范本）
//
// 关键结论（2026-09-19 树内实测定稿）：
// - Soong 无 "compose" 属性（unrecognized property，勿用）
// - Compose 编译器由 kotlinc_incremental 内嵌（kotlin-compose-compiler-embeddable），
//   全树 Kotlin 模块默认可用，无需 plugins: 或 -Xplugin
// - "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true"
//   只是可选的插件参数（生成源信息定位），官方范本同款
android_app {
    name: "spike-compose",
    // platform 签名特权应用路线：显式对 platform API 编译（SystemApi/@hide 的前提，
// LOS 23.2 官方 SceneTransitionLayoutDemo 同款）；不写则 sdk_version 为空触发此冲突
    platform_apis: true,
    srcs: ["src/com/operit/spike/*.kt"],
    static_libs: [
        "androidx.compose.runtime_runtime",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.ui_ui",
        "androidx.activity_activity-compose",
    ],
    kotlincflags: [
        "-Xjvm-default=all",
        "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true",
    ],
    manifest: "AndroidManifest.xml",
    min_sdk_version: "26",
}
// 注意：sdk_version 与 platform_apis 是二选一：
// - platform_apis: true → 对 platform API 编译（特权应用路线，本项目选此）
// - sdk_version: "current" → 对 public SDK 编译（普通应用路线）
// 两者都不写 = sdk_version 隐式为空 → Soong 报 platform_apis 冲突（已踩）
